;; shadow-cljs browser build for the slides editor hydration adapter
;; (slides.web.client). Pulls cljs/reagent/re-frame from deps.edn :cljs alias
;; on top of the repo's own deps (same pattern as kami-mangaka-reader,
;; ADR-2606282101). Release output is docs/js/main.js — a checked-in Pages
;; artifact like docs/index.html / docs/main.css:
;;   npm ci && npx shadow-cljs release app
{:deps {:aliases [:cljs]}
 :builds {:app {:target :browser
                :output-dir "docs/js"
                :asset-path "js"
                :modules {:main {:init-fn slides.web.client/init}}}}}
