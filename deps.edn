{:paths ["src" "resources"]
 ;; Zero third-party runtime deps. Every namespace is portable .cljc for JVM,
 ;; ClojureScript, and SCI-style hosts.
 :deps {io.github.kotoba-lang/office
        {:git/url "https://github.com/kotoba-lang/office.git"
         :git/sha "b5838def811d05f1db1e7d77e5daede8ac953883"}
        io.github.kotoba-lang/ooxml
        {:git/url "https://github.com/kotoba-lang/ooxml.git"
         :git/sha "4b87825e63ecc78bf97f26d98ff87c8bac7a26cd"}
        io.github.kotoba-lang/transit
        {:git/url "https://github.com/kotoba-lang/transit.git"
         :git/sha "0d45c3020071cdedffe504d8fc0d9884938e4120"}
        io.github.kotoba-lang/drawingml
        {:git/url "https://github.com/kotoba-lang/drawingml.git"
         :git/sha "0ac7037768731333920e1c1cf149d89f0934b6d7"}
        io.github.kotoba-lang/presentationml
        {:git/url "https://github.com/kotoba-lang/presentationml.git"
         :git/sha "31aa3e3d73859f505042467c4c0a44c4ae3fa0bf"}
        io.github.kotoba-lang/office-style
        {:git/url "https://github.com/kotoba-lang/office-style.git"
         :git/sha "40ce484f923475e1bb59919cc03f6664737f0e08"}
        ;; kotoba-lang design-system paved road (ADR-2607122200): the app
        ;; requires kotoba-ui.core (single entry: shell/theme/->page + all
        ;; component aliases) + appkit.core (desktop/dense-data defaults).
        ;; These are :local/root west-sibling deps — kotoba-ui itself declares
        ;; shitsuke/liquid-glass-ui as :local/root, so the whole stack must be
        ;; pinned :local/root here too (git-sha vs :local/root coordinates for
        ;; the same lib are uncomparable and fail the classpath build — same
        ;; resolution as the appkit exemplar, gftdcojp/cloud-itonami#393).
        ;; CI clones these four siblings before running (see ci.yml).
        io.github.kotoba-lang/kotoba-ui {:local/root "../kotoba-ui"}
        io.github.kotoba-lang/appkit {:local/root "../appkit"}
        io.github.kotoba-lang/liquid-glass-ui {:local/root "../liquid-glass-ui"}
        ;; shitsuke: shared UI design system (tokens + hiccup + style +
        ;; portable re-frame seam + components). Pure .cljc, zero runtime deps.
        ;; :local/root (was :git/sha) — see the kotoba-ui note above; the
        ;; sibling main also carries the reagent-safe :on-input→:on-change
        ;; controlled-input fix (kotoba-lang/shitsuke PR #4) and shitsuke.hig.
        io.github.kotoba-lang/shitsuke {:local/root "../shitsuke"}
        ;; canvaskit: canvas/viewport interaction math, Apple HIG/UIKit
        ;; vocabulary (ADR-2607071130). slides.web.events uses the zoom-scale
        ;; clamp for the editor canvas zoom.
        io.github.kotoba-lang/canvaskit
        {:git/url "https://github.com/kotoba-lang/canvaskit.git"
         :git/sha "fba5b558710faa1414f1e42573aa211645a864e1"}
        ;; kotoba-lang/html: standalone hiccup->HTML renderer (the extracted
        ;; substrate shitsuke.hiccup itself is built on). Used for the docs/
        ;; Pages shell (site.clj) per 90-docs/adr/2607022800.
        io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/html.git"
         :git/sha "31a26731f68f635d10c3ebf1e791d53c07a711b3"}
        ;; kotoba-lang/css: CSS as EDN data. Used for the docs/main.css build
        ;; (build.clj) instead of a hand-typed static.css string.
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/css.git"
         :git/sha "e8bb830b69aa1a726bb79dbd28f098f0875db673"}
        io.github.kotoba-lang/xml
        {:git/url "https://github.com/kotoba-lang/xml.git"
         :git/sha "568e022a38bea2d97dda2487b930d48d8a61609c"}}
 :aliases
 {:cli {:main-opts ["-m" "slides.cli"]}
  :local {:override-deps {io.github.kotoba-lang/office
                          {:local/root "../office"}
                          io.github.kotoba-lang/ooxml
                          {:local/root "../ooxml"}
                          io.github.kotoba-lang/drawingml
                          {:local/root "../drawingml"}
                          io.github.kotoba-lang/presentationml
                          {:local/root "../presentationml"}
                          io.github.kotoba-lang/office-style
                          {:local/root "../office-style"}
                          io.github.kotoba-lang/shitsuke
                          {:local/root "../shitsuke"}
                          io.github.kotoba-lang/kotoba-ui
                          {:local/root "../kotoba-ui"}
                          io.github.kotoba-lang/appkit
                          {:local/root "../appkit"}
                          io.github.kotoba-lang/liquid-glass-ui
                          {:local/root "../liquid-glass-ui"}
                          io.github.kotoba-lang/html
                          {:local/root "../html"}
                          io.github.kotoba-lang/css
                          {:local/root "../css"}
                          io.github.kotoba-lang/xml
                          {:local/root "../xml"}}}
  :pages {:main-opts ["-m" "slides.build"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :coverage {:extra-paths ["test"]
             :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}
                          io.github.cognitect-labs/test-runner
                          {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
             :main-opts ["-m" "cloverage.coverage"
                         "--ns-regex" "slides\\.(model|design|routes|render|validate|pptx|office|causal|svgraph|wire|hiccup|site|build|cli|web\\.(events|views|sample|ssr))"
                         "--test-ns-regex" "slides\\..*-test"
                         "--src-ns-path" "src"
                         "--test-ns-path" "test"
                         "--output" "target/coverage"
                         "--no-html"
                         "--text"
                         "--lcov"
                         "--fail-threshold" "85"]}
  :coverage-thresholds {:extra-paths ["test"]
                        :main-opts ["-m" "slides.coverage-gate"]}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
